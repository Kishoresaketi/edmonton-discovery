# Copy this file to .env and set credentials locally. Never commit .env.
PORT=4173
APP_BASE_URL=http://localhost:4173

# Email verification via Resend. Verify a sender/domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM=Edmonton Discovery <onboarding@example.com>

# Google OAuth Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REPORTS_ADMIN_TOKEN=
# Register this exact callback URL in Google Cloud Console:
# http://localhost:4173/auth/google/callback
