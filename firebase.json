{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", ".env", ".git/**", "data/**", "node_modules/**", "package*.json", "server.js", "README.md", "*.log"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "X-Frame-Options", "value": "SAMEORIGIN" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
